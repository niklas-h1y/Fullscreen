{
  "manifest_version": 3,
  "name": "Fullscreen",
  "version": "1.0.0",
  "description": "Hide the browser toolbar and search/address bar by toggling fullscreen mode.",
  "action": {
    "default_title": "Enter fullscreen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle browser fullscreen"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fullscreen-toggle@example.com",
      "strict_min_version": "109.0"
    }
  }
}